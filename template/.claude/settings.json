{
  "model": "sonnet",
  "effortLevel": "medium",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {},
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(node .claude/scripts/branches.mjs:*)",
      "Bash(node .claude/scripts/ledger.mjs next:*)",
      "Bash(node .claude/scripts/ledger.mjs setup:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git worktree add:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git merge:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git * push*)",
      "Bash(git * reset --hard*)",
      "Bash(git * clean*)",
      "Bash(git * branch -D*)",
      "Bash(git * checkout -- *)",
      "Bash(git * restore*)",
      "Bash(git * stash drop*)",
      "Bash(git * stash clear*)",
      "Bash(git restore:*)",
      "Bash(git reflog:*)",
      "Bash(git gc:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",
      "Bash(git tag -d:*)",
      "Bash(git worktree prune:*)",
      "Bash(git * commit*--amend*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow run:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(mv:*)",
      "Bash(truncate:*)",
      "Bash(node .claude/scripts/ledger.mjs land:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout:* -- :*)",
      "Bash(git checkout .)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout -B:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -C:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/*.min.js)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/branches.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel)/.claude/statusline.mjs\""
  }
}
